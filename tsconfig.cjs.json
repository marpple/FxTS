{
  "include": ["./src/"],
  "exclude": ["./node_modules/", "./test/"],
  "compilerOptions": {
    "target": "es2018",
    "module": "commonjs",
    "lib": ["es2020"],
    "sourceMap": true,
    "inlineSources": true,
    "outDir": "./dist/cjs/",
    "rootDir": "./src/",
    "importHelpers": true,
    "isolatedModules": true,
    "strict": true,
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  }
}
